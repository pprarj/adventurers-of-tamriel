Scriptname AoT_Card extends Quest
{Adventurer card: a web panel (one screen) with the player's own guild record and the
perk trees the player chose (D016). It never writes to the guild; the one thing
it does is spend a perk point on a click, through Lodestone.TryBuyPerk.
Opens on a hotkey through the Lodestone WebUI bridge.
The handshake, the watchdog and the fallback are the same ones Intelligence Matters uses
for its journal panel (IM_SpellResearch, "O APERTO DE MAO" and OnUpdate), copied here.
D144: this quest also owns the portrait key and the background page (portrait.html), a view of its own with the same
handshake; the files and the choice are AoT_Portrait's. The card and the page are never open together, so the
single OnUpdate slot serves whichever is open.}

; ---------------------------------------------------------------------------
; Contract with the page (card.html). NOTHING VALIDATES THESE NAMES: a typo is
; a call that silently does nothing. They must match window.AoTOnCard,
; window.AoTCardAction and window.AoTCardLog in the page.
; ---------------------------------------------------------------------------

String Property ViewId     = "AdventurersOfTamrielCard" AutoReadOnly
String Property ViewPath   = "AdventurersOfTamriel/card.html" AutoReadOnly
String Property FnCard     = "AoTOnCard" AutoReadOnly
String Property FnAction   = "AoTCardAction" AutoReadOnly
String Property EvtAction  = "AoT_WebUICardAction" AutoReadOnly
String Property FnLog      = "AoTCardLog" AutoReadOnly
String Property EvtLog     = "AoT_WebUICardLog" AutoReadOnly
String Property EvtReady   = "LodestoneWebUIViewReady" AutoReadOnly

; Two floors, one per surface. Never one number for both: the web surface and
; the focus surface entered in different DLL versions.
; 1023000 (1.23.0) is where the web UI level left the mod root (see
; IM_Core.WebUIMinVersion); 1022000 (1.22.0) is where WebUIFocusView exists.
Int Property WebUIMinVersion      = 1023000 AutoReadOnly
Int Property WebUIFocusMinVersion = 1022000 AutoReadOnly
; 1037000 (Nexus 1.6.0) is the perk module (GetPerkPoints, TryBuyPerk, GetPerkTree*).
; Below it the card opens without trees and says why.
Int Property PerkMinVersion       = 1037000 AutoReadOnly
; 1044000 (1.44.0) adds GetPerkTreeOffsetX / GetPerkTreeOffsetY (the node's fine position, HNAM / VNAM). Below it the
; card draws on the integer grid alone (D094).
Int Property OffsetMinVersion     = 1044000 AutoReadOnly
; D144: opening the card no longer takes a picture. It shows the confirmed portrait (AoT_Portrait, Lodestone 1.53.0)
; over the confirmed background; below that version, or with none confirmed, the silhouette.

; D144: the background page. Same rules as the card's names above: nothing validates them against portrait.html.
String Property PViewId    = "AdventurersOfTamrielPortrait" AutoReadOnly
String Property PViewPath  = "AdventurersOfTamriel/portrait.html" AutoReadOnly
String Property FnPortrait = "AoTOnPortrait" AutoReadOnly
String Property FnPAction  = "AoTPortraitAction" AutoReadOnly
String Property EvtPAction = "AoT_WebUIPortraitAction" AutoReadOnly
String Property FnPLog     = "AoTPortraitLog" AutoReadOnly
String Property EvtPLog    = "AoT_WebUIPortraitLog" AutoReadOnly
; After the page is hidden for "take another", how long to let the game leave the menu mode before the capture.
Float Property RetakeSettle = 0.25 AutoReadOnly

; DirectX scan code of the hotkey: the settings page writes it (D077), AoT_Core.CardKey() reads it at the
; moment of use; 65 (F7) is the default. _regKey is the key registered now, 0 in a save made before the option.
Int _regKey = 0
; D144: the portrait key registered now (AoT_Core.PortraitKey(), 66 = F8); 0 in a save made before 1.3.
Int _regPortraitKey = 0
; DirectX scan code of Esc. Registered ONLY while the card is open or opening (D021):
; with the card closed Esc belongs to the game and this mod does not listen.
Int Property EscCode = 1 AutoReadOnly

; How long to wait for the page to announce itself before giving up on it.
Float Property HelloSeconds    = 6.0 AutoReadOnly
; Period of the focus watchdog.
Float Property WatchdogSeconds = 1.0 AutoReadOnly

; D154: the card in the hand (behavior patch aotc, generated by Pandora or Nemesis). Deadlines for the two answers of
; the graph: AoTCardReady at the end of the entry clip (23/24 s) and AoTCardHidden at the end of the exit clip (27/24 s).
; Without a generated behavior the Ready never comes and the card opens full screen, as in 1.2.
Float Property AnimReadySeconds  = 2.0 AutoReadOnly
Float Property AnimHiddenSeconds = 2.5 AutoReadOnly
; The tap clip is 1 s; past this a missing AoTCardTapDone no longer blocks the next tap.
Float Property AnimTapSeconds    = 2.0 AutoReadOnly
; D187: the page is a 2D layer drawn over all of the 3D (D159), so a finger sent to the 3D card goes behind the page.
; While the page is drawn over the card, a click acts with no gesture and the hand keeps holding the card still. The
; tap path stays for a page drawn on the card's own texture, which would put the finger in front (BACKLOG).
Bool Property PageOnCardTexture = False AutoReadOnly
; D164: with the aotc patch in the graph, a missing AoTCardReady is a late or a lost one, not a missing behavior. The
; entry clip draws the card at 0.2 s (AnimObjDraw) and annotates the Ready at 23/24 s, about this long after the draw.
Float Property AnimDrawToReady   = 0.9 AutoReadOnly
; D166: the entry clip starts (AnimObjLoad at 0.04 s) about this long before its Ready (23/24 s).
Float Property AnimLoadToReady   = 1.0 AutoReadOnly
; D178: the card mesh (aot_guild_card.nif) and the first person eye. The mesh's root node hangs from AnimObjectA; its
; face lies in the root's y = 0 plane, x across and z up, these half sizes (the texture's UV square is the whole face).
; The eye in first person is the world position of Camera1st (the view turns with the player's heading and pitch).
String Property CardNode  = "AoT Guild Card" AutoReadOnly
String Property CardBone  = "AnimObjectA" AutoReadOnly
String Property EyeNode   = "Camera1st [Cam1]" AutoReadOnly
Float Property CardHalfW  = 11.0 AutoReadOnly
Float Property CardHalfH  = 7.6607 AutoReadOnly
; D181: the first person field of view, from the game's own setting (SKSE Utility.GetINIFloat; the SKSE builds of
; this runtime bind no Camera.Get*FieldOfView). Out of range: the one the card itself showed at 2560 x 1440 (the
; quad of both openings measured for D181 within 3 and 14 px), and the line says so.
String Property FovSetting      = "fDefault1stPersonFOV:Display" AutoReadOnly
String Property FovWorldSetting = "fDefaultWorldFOV:Display" AutoReadOnly
Float Property FovMesh          = 78.5 AutoReadOnly
; D186: the smallest the card's face may come out of the measure, in tangents (across and down over the distance
; ahead, the mean of the two edges). The card in the hand spans about 0.81 x 0.56 (CARD_QUAD of the page, and every
; good measure of F17e9c5); under half of that, or turned over, the reading is not the card in the hand (one measure
; of F17e9c5 came out 0.03 x 0.02), and the reading is taken again (D191).
Float Property MinTanW = 0.4 AutoReadOnly
Float Property MinTanH = 0.28 AutoReadOnly
; D191: a reading that fails (D186, or no node) is taken again before the view opens, MeasureTries readings in all,
; MeasureGap s apart. The camera is held still from the key (D184), so a later reading differs only when the earlier
; one did not read the card in the hand (one opening of F17e9c8 read the card node 570 units ahead of the eye).
Int Property MeasureTries = 4 AutoReadOnly
Float Property MeasureGap = 0.1 AutoReadOnly
; How long to wait for a drawn weapon to go away, and for the camera to reach first person.
Float Property SheatheSeconds    = 3.0 AutoReadOnly
Float Property CameraSeconds     = 1.0 AutoReadOnly
; D184: with the card in the hand the player stands still: the controls are taken at the key (Lock) and given back
; when the hand has put the card away (Unlock), and the view takes the focus (the cursor) as soon as the page is ready.
; D159: a camera that a close sent back to third person within this time still counts as third person at an opening.
Float Property ThirdBackSeconds  = 1.5 AutoReadOnly
; The UV square the 4x3 grid of tap clips covers: a tap outside is moved to the nearest edge.
Float Property TapUMin = 0.324 AutoReadOnly
Float Property TapUMax = 0.617 AutoReadOnly
Float Property TapVMin = 0.573 AutoReadOnly
Float Property TapVMax = 0.894 AutoReadOnly

; ---------------------------------------------------------------------------
; Session cstate. Every flag here is bounded by the single OnUpdate timer, so a
; save taken in the middle of an opening cannot leave one stuck true.
; ---------------------------------------------------------------------------

Bool _pending       = False
Bool _visible       = False
Bool _wanted        = False
Bool _awaitingHello = False
; D103: True once the payload of this opening left. A "ready" before it is the page's own hello at load, which can
; overtake the payload while BuildPayload runs; trees pushed then were wiped by the payload that came after them.
Bool _payloadSent   = False
; D144: the confirmed portrait's file for THIS opening, read at the opening; sent in the payload, then cleared.
String _portrait = ""

; D154: 0 no card in the hand, 1 waiting for AoTCardReady, 2 in the hand, 3 putting it away (waiting for AoTCardHidden).
Int _anim = 0
; True when THIS opening forced first person: closing gives third person back.
Bool _animThird = False
; Real time the current wait of _anim began.
Float _animAt = 0.0
; True when the page draws over the 3D card (c_anim|1) for this opening.
Bool _animLive = False
; D178: the 3D card as the eye sees it at the Ready, "fov,a0,b0,a1,b1,a2,b2,a3,b3" (the first person field of view,
; then each corner's tangents: right and up over the distance ahead, top-left first, clockwise); "" when not measured,
; and the page keeps its fixed quad. _fitTold: the page's first fit of this opening was written out.
String _quad = ""
Bool _fitTold = False
; D178: the reading behind _quad, kept for the line written after the view opened (_placedWhy "" = measured).
String _placedWhy = ""
String _placedNode = ""
Float[] _placedAt
Float[] _placedRot
Float[] _placedEye
Float _placedFov = 0.0
Float _placedYaw = 0.0
Float _placedPitch = 0.0
; D181: where _placedFov came from ("ini" or "mesh") and the setting as read; read once per opening, at the Ready.
String _placedFovBy = ""
Float _placedFovIni = 0.0
; D191: what the page was given (measured, remeasured, last, fixed), how many readings it took, and each failed
; reading's reason with where the card node and the AnimObjectA bone were ("why@node@bone=..;"). D192: the last
; measured quad of this load ("" none), the page's place when every reading fails.
String _placedBy = ""
Int _placedTries = 0
String _placedMisses = ""
String _lastGoodQuad = ""
Bool _tapBusy = False
Float _tapAt = 0.0
; D184: this script took the player's controls (Lock) and owes them back; the real time it took them; how the last
; close came (ClosePanel's asVia), for the line that gives them back.
Bool _locked = False
Float _lockAt = 0.0
String _closeVia = ""
; Real time of the last ForceThirdPerson of a close (0 none).
Float _thirdBackAt = 0.0
; The hint about closing the card in the hand, once per load.
Bool _hintShown = False
; D162: the real time the single update of this form is due (0 none). A tick before it was registered earlier: an
; update already queued still arrives after a newer registration replaced it, and the portrait's watchdog left one
; that cut the card's wait for the hand short.
Float _tickDue = 0.0
; D164, D166: what the graph said during the wait for the hand. _animGraph: the graph took this AoTCardOpen (it left
; its state at once, an AnimObjectUnequip before the entry clip's first trigger, or the entry clip ran). Real times
; (0 none): the entry clip began (AnimObjLoad) and drew the card (AnimObjDraw), the card left the hand after that
; (AnimObjectUnequip). One more AoTCardOpen and one more wait at most per opening.
Bool _animGraph = False
Float _animLoadAt = 0.0
Float _animDrawAt = 0.0
Float _animLeftAt = 0.0
Bool _animResent = False
Bool _animWaited = False
Bool _animLoadWaited = False
; D166: an entry clip ran since the last load (the patch is in the player's graph); a load clears it.
Bool _graphSeen = False
; D166: the card key went down while the hand put the card away. The card comes back after the away; one more press
; before that takes it back. The last press wins.
Bool _reopen = False

; D144: the background page, the same four flags as the card's, its own.
Bool _pPending       = False
Bool _pVisible       = False
Bool _pWanted        = False
Bool _pAwaitingHello = False
Bool _pPayloadSent   = False
; True while a capture runs (the page is hidden then); every key and button waits for it.
Bool _pBusy          = False
; The file of the capture not yet confirmed ("" none), and the reason of the last refusal ("" none).
String _pNew    = ""
String _pReason = ""
; D165: the card key found no confirmed portrait and opened this page instead. Its confirm opens the card; any other
; close of the page drops it, and the next press of the card key comes back here.
Bool _cardAfter = False
; D165: 1 in the save once the page was confirmed at least once, with a photo or without one (a refused capture and the
; background alone). From then on the card key opens the card, with the silhouette if there is still no portrait.
String Property PConfirmedKey = "aot_portrait_confirmed_once" AutoReadOnly

; The skills drawn right now, one per column, filled at every opening. A buy
; click names a column and a node index; the index is only meaningful against
; the tree of THAT skill, read again at click time (same order every call).
String[] _skills
Int _skillCount = 0
; Set by NextToBuy: the position in the rank chain of the highest owned rank, and that rank (None when none owned).
Int _lastHighest = -1
Perk _lastOwned = None
; Set by NodeState: the rank the player would take next (None when the chain is complete).
Perk _lastTarget = None

; D093: the last perks taken ("Skill:Perk^...", newest first, at most RecentMax) and, per skill, how many ranks of
; each node the player had at the last read of that tree. Both live in the save (StorageUtil on None).
String Property RecentKey  = "aot_card_recent" AutoReadOnly
String Property OwnedKey   = "aot_card_own_" AutoReadOnly
Int Property RecentMax     = 4 AutoReadOnly

Event OnInit()
	ApplyKey()
EndEvent

Function ApplyKey()
	{Registers the card key of the settings page; drops the previous registration when it changed. A save made
	before the option has _regKey = 0 and a registration of 65: that one is dropped too.}
	Int want = AoT_Core.CardKey()
	If _regKey == 0
		If want != 65
			UnregisterForKey(65)
		EndIf
	ElseIf _regKey != want
		UnregisterForKey(_regKey)
	EndIf
	Int before = _regKey
	_regKey = want
	RegisterForKey(want)
	; D144: the portrait key; a previous one is dropped unless the card key took it over
	Int pwant = AoT_Core.PortraitKey()
	If _regPortraitKey != 0 && _regPortraitKey != pwant && _regPortraitKey != want
		UnregisterForKey(_regPortraitKey)
	EndIf
	_regPortraitKey = pwant
	RegisterForKey(pwant)
	; Always on (not behind AoT_Core.Log): once per load and per key change, and it tells a run whether this
	; script is alive at all - a missing quest leaves no other trace.
	Debug.Trace("[AoT] Card: ApplyKey registered=" + want + " previous=" + before + " portrait=" + pwant)
EndFunction

Event OnKeyDown(Int aiKeyCode)
	; Always on: only the card key, the portrait key and Esc are registered, so this fires on those presses only.
	Debug.Trace("[AoT] Card: OnKeyDown code=" + aiKeyCode + " cardKey=" + AoT_Core.CardKey() + " portraitKey=" + AoT_Core.PortraitKey() + " visible=" + _visible + " page=" + _pVisible + " member=" + AoT_Core.IsMember())
	If aiKeyCode == EscCode
		; D166: Esc takes back a press kept through an away
		_reopen = False
		If _visible || _awaitingHello || _anim == 1
			ClosePanel("esc")
		ElseIf _pVisible || _pAwaitingHello
			PortraitClose("esc")
		ElseIf !_pBusy
			; A registration left over from a save taken with the card open.
			UnregisterForKey(EscCode)
		EndIf
		Return
	EndIf
	If aiKeyCode == AoT_Core.PortraitKey()
		PortraitKeyDown()
		Return
	EndIf
	If aiKeyCode != AoT_Core.CardKey()
		Return
	EndIf
	; D184: the card in the hand closes on the press, as the full-screen card (the hold and the cursor of D159 are gone)
	; Closing our own panel is never a game action: it comes BEFORE the menu
	; guard, which only gates opening (a focused view may read as menu mode).
	If _visible || _awaitingHello || _anim == 1 || _anim == 2
		ClosePanel("key")
		Return
	EndIf
	; D154: one card at a time. D166: a press while the hand puts the last one away is not dropped: it opens the card
	; after the away (below, once the gates pass), and a second press before that takes it back.
	If _reopen
		_reopen = False
		Debug.Trace("[AoT] Card: OnKeyDown while the card is being put away, reopen=False")
		Return
	EndIf
	; D144: never over the background page, nor while it takes a picture
	If _pVisible || _pAwaitingHello || _pPending || _pBusy
		Debug.Trace("[AoT] Card: OnKeyDown ignored, the portrait page is open")
		Return
	EndIf
	; Always on: a silent Return here would leave a card that never opens with no trace at all.
	Bool inMenu = Utility.IsInMenuMode()
	Bool inText = UI.IsTextInputEnabled()
	If inMenu || inText
		Debug.Trace("[AoT] Card: OnKeyDown ignored, menuMode=" + inMenu + " textInput=" + inText)
		Return
	EndIf
	; D093: with a modifier chosen on the settings page, the key alone does not open (closing above never needs it)
	If !AoT_Core.CardModifierHeld()
		Debug.Trace("[AoT] Card: OnKeyDown ignored, modifier " + AoT_Core.CardModifierName(AoT_Core.CardModifier()) + " not held")
		Return
	EndIf
	; D077: the card belongs to the guild's members; the attendant enrols a new character
	If !AoT_Core.IsMember()
		Debug.Notification("You are not a member of the Adventurers Guild.")
		Return
	EndIf
	; D166: the press waits for the away (AnimDone)
	If _anim == 3
		_reopen = True
		Debug.Trace("[AoT] Card: OnKeyDown while the card is being put away, reopen=True")
		Return
	EndIf
	; D165: the first time, the portrait first; the card opens once one is confirmed
	If PortraitFirst()
		Return
	EndIf
	OpenCard()
EndEvent

String Function KeyName(Int aiScanCode)
	If aiScanCode >= 59 && aiScanCode <= 68
		Return "F" + (aiScanCode - 58)
	ElseIf aiScanCode == 87 || aiScanCode == 88
		Return "F" + (aiScanCode - 76)
	EndIf
	Return "the card key"
EndFunction

Function MenusOn()
	{D159: between the key and the focus (the card on its way to the hand) nothing takes the panel away when a menu opens
	over the game; these do. D184: they stay on with the focus, a second way out.}
	RegisterForMenu("Journal Menu")
	RegisterForMenu("TweenMenu")
	RegisterForMenu("InventoryMenu")
	RegisterForMenu("MagicMenu")
	RegisterForMenu("MapMenu")
	RegisterForMenu("StatsMenu")
	RegisterForMenu("FavoritesMenu")
	RegisterForMenu("ContainerMenu")
	RegisterForMenu("BarterMenu")
	RegisterForMenu("GiftMenu")
	RegisterForMenu("Crafting Menu")
	RegisterForMenu("Dialogue Menu")
	RegisterForMenu("Lockpicking Menu")
	RegisterForMenu("Sleep/Wait Menu")
	RegisterForMenu("Book Menu")
	RegisterForMenu("Training Menu")
	RegisterForMenu("LevelUp Menu")
	RegisterForMenu("MessageBoxMenu")
EndFunction

Event OnMenuOpen(String asMenuName)
	If _visible || _awaitingHello || _anim == 1 || _anim == 2
		AoT_Core.Log("[AoT] Card: menu " + asMenuName + " opened over the card")
		ClosePanel("menu")
	EndIf
EndEvent

; ---------------------------------------------------------------------------
; Opening
; ---------------------------------------------------------------------------

Bool Function CanUsePanel()
	{Both gates: the web surface and the focus surface. The panel is interactive
	only (a card that cannot be closed would be a poster), so no focus, no panel.}
	If Lodestone.GetVersion() < WebUIFocusMinVersion || Lodestone.GetVersion() < WebUIMinVersion
		Return False
	EndIf
	If !Lodestone.WebUIAvailable()
		Return False
	EndIf
	Return Lodestone.WebUIHasCapability("view-focus")
EndFunction

Function OpenCard()
	Debug.Trace("[AoT] Card: OpenCard pending=" + _pending + " ready=" + Lodestone.WebUIIsViewReady(ViewId))
	; An orphan from before a load: the view outlives the load, the flags do not.
	If !_visible && Lodestone.WebUIIsViewReady(ViewId) && Lodestone.WebUIIsViewVisible(ViewId)
		Lodestone.WebUIClearFocus(ViewId)
		Lodestone.WebUIHide(ViewId)
	EndIf

	If !CanUsePanel()
		Debug.Trace("[AoT] Card: panel not available, plain card")
		ShowPlain()
		Return
	EndIf

	_wanted = True
	RegisterForKey(EscCode)
	MenusOn()
	; D154: the card comes to the hand first; the panel follows on AoTCardReady, or on its deadline (AnimFallback)
	If AnimStart()
		Return
	EndIf
	OpenView()
EndFunction

Function OpenView()
	{The panel's part of the opening: the view, then OpenNow. Direct from OpenCard, or after the card reached the hand.}
	; Truth is the question, not the saved flag: after a load the view is gone.
	If Lodestone.WebUIIsViewReady(ViewId)
		OpenNow()
		Return
	EndIf
	If _pending
		Debug.Trace("[AoT] Card: OpenCard ignored, an opening is already pending")
		Return
	EndIf

	; Register BEFORE asking: the view may become ready between two lines, and
	; an event with no receiver is lost forever.
	RegisterForModEvent(EvtReady, "OnCardReady")
	_pending = True
	; The wait for the page is the only timer in this phase.
	Tick(HelloSeconds)
	If !Lodestone.WebUICreateView(ViewId, ViewPath)
		_pending = False
		_wanted = False
		UnregisterForKey(EscCode)
		Debug.Trace("[AoT] Card: WebUICreateView refused " + ViewPath)
		ShowPlain()
		Return
	EndIf
	Debug.Trace("[AoT] Card: WebUICreateView accepted " + ViewPath)
EndFunction

Event OnCardReady(String asEvent, String asViewId, Float afNum, Form akSender)
	; D144: one receiver for the ready event of both views (a second registration of the same event replaces the first)
	If asViewId == PViewId
		PortraitReady()
		Return
	EndIf
	If asViewId != ViewId || !_pending
		Return
	EndIf
	_pending = False
	RegisterForModEvent(EvtAction, "OnCardAction")
	RegisterForModEvent(EvtLog, "OnCardLog")
	Lodestone.WebUIRegisterListener(ViewId, FnAction, EvtAction)
	Lodestone.WebUIRegisterListener(ViewId, FnLog, EvtLog)
	If !_wanted
		Return
	EndIf
	OpenNow()
EndEvent

Function OpenNow()
	{SHOW comes first and FOCUS only after the page said "ready": ready from the
	bridge means SOME page loaded (an error page loads too). Only the page can say
	it is OURS, and it does that by calling AoTCardAction("ready-...").}
	_awaitingHello = True
	_payloadSent = False
	Tick(HelloSeconds)
	; D144: no capture here any more; the confirmed portrait is looked up (not latent, nothing written)
	_portrait = AoT_Portrait.ConfirmedFile()
	String shown = _portrait
	If shown == ""
		shown = "none"
	EndIf
	; Always on, like the key lines: it is the line the bench reads. One per opening.
	Debug.Trace("[AoT] Card: portrait " + shown + " bg=" + AoT_Portrait.Background() + " slot=" + AoT_Portrait.ConfirmedSlot())
	Lodestone.WebUIShow(ViewId)
	_visible = True
	Push()
EndFunction

Function PollMissives()
	{D116: the open Missives contracts are read now, not at the next hourly poll, so a delivery just done does not show as
	in progress. Soft: without the Missives plugin there is no adapter and nothing changes.}
	AoT_MissivesAdapter ma = AoT_Attendant.MissivesAdapter()
	If ma
		ma.PollOpenContracts()
	EndIf
EndFunction

Function Push()
	PollMissives()
	AoT_Core.Log("[AoT] Card: push rank=" + RankLetter(AoT_Core.GetRank()) + " points=" + AoT_Core.GetPoints())
	String payload = BuildPayload()
	_portrait = ""
	Lodestone.WebUICall(ViewId, FnCard, payload)
	_payloadSent = True
EndFunction

Function PushTrees()
	{One call per column, so the card draws as each tree is read: reading the states
	costs native calls and the player should see the first column early. Stops when
	the panel closes in the middle.}
	If !PerkOk()
		Return
	EndIf
	_skillCount = ResolveTrees()
	; The page lays out its columns from this count before any tree arrives.
	Lodestone.WebUICall(ViewId, FnCard, "c_trees|" + _skillCount)
	Int slot = 0
	While slot < _skillCount && _visible
		Lodestone.WebUICall(ViewId, FnCard, BuildTree(slot))
		slot += 1
	EndWhile
EndFunction

Event OnCardAction(String asEvent, String asAction, Float afNum, Form akSender)
	String act = Unwrap(asAction)
	If StringUtil.Find(act, "ready") == 0
		If !_awaitingHello
			Return
		EndIf
		; D103: the page answers every payload with "ready", so the one that counts comes after ours
		If !_payloadSent
			AoT_Core.Log("[AoT] Card: early " + act + " ignored, payload not sent yet")
			Return
		EndIf
		_awaitingHello = False
		AoT_Core.Log("[AoT] Card: page said " + act)
		If _animLive
			; D184: the card in the hand takes the focus at once, as the full-screen card: the cursor is there, the player
			; already stands still (Lock, at the key), and a press of the card key or Esc puts the card away
			If !_hintShown
				_hintShown = True
				Debug.Notification("Press " + KeyName(AoT_Core.CardKey()) + " or Esc to put the card away.")
			EndIf
			; The page first: it reads the card key only after a release (the press that opened the card may still be down)
			Lodestone.WebUICall(ViewId, FnCard, "c_cursor|1")
		EndIf
		AoT_Core.Log("[AoT] Card: asking focus; menuMode=" + Utility.IsInMenuMode())
		If !Lodestone.WebUIFocusView(ViewId)
			; Refusal is a normal case: one view at a time in the whole load order.
			Debug.Trace("[AoT] Card: WebUIFocusView refused")
			HideQuiet()
			ShowPlain()
			Return
		EndIf
		If _animLive
			; Always on: the line the bench reads, one per opening in the hand
			Debug.Trace("[AoT] Card: cursor on")
		EndIf
		Tick(WatchdogSeconds)
		PushTrees()
	ElseIf StringUtil.Find(act, "close") == 0
		ClosePanel("page")
	ElseIf StringUtil.Find(act, "tap-at|") == 0
		TapAt(act)
	ElseIf StringUtil.Find(act, "buy|") == 0
		String[] parts = PapyrusUtil.StringSplit(act, "|")
		If parts.Length == 3
			BuyPerk(parts[1] as Int, parts[2] as Int)
		EndIf
	EndIf
EndEvent

Event OnCardLog(String asEvent, String asText, Float afNum, Form akSender)
	String t = Unwrap(asText)
	; D179: the first fit of an opening in the hand is always written: where the page put the card, and from what
	If _animLive && !_fitTold && StringUtil.Find(t, "fit|anim=1") == 0
		_fitTold = True
		Debug.Trace("[AoT] Card page: " + t)
		Return
	EndIf
	AoT_Core.Log("[AoT] Card page: " + t)
EndEvent

; The page's argument may come wrapped in one pair of double quotes.
String Function Unwrap(String asRaw)
	Int n = StringUtil.GetLength(asRaw)
	If n < 2
		Return asRaw
	EndIf
	String quote = StringUtil.AsChar(34)
	If StringUtil.GetNthChar(asRaw, 0) != quote || StringUtil.GetNthChar(asRaw, n - 1) != quote
		Return asRaw
	EndIf
	Return StringUtil.Substring(asRaw, 1, n - 2)
EndFunction

; ---------------------------------------------------------------------------
; Watchdog and closing
; ---------------------------------------------------------------------------

Function Tick(Float afSeconds)
	{D162: every timer of this form goes through here, so OnUpdate can tell its own tick from an older one.}
	_tickDue = Utility.GetCurrentRealTime() + afSeconds
	RegisterForSingleUpdate(afSeconds)
EndFunction

; OnUpdate is per FORM, not per script: this quest carries exactly one script.
; The two timers (hello wait, focus watchdog) are mutually exclusive and share
; the single slot.
Event OnUpdate()
	; D162: an older tick waits out the rest of the current timer (never more than the longest one: real time starts
	; again with the game, and a due time from before a load means nothing)
	Float early = _tickDue - Utility.GetCurrentRealTime()
	If early > 0.05 && early <= HelloSeconds
		Debug.Trace("[AoT] Card: early tick, " + early + " s left, anim=" + _anim)
		RegisterForSingleUpdate(early)
		Return
	EndIf
	_tickDue = 0.0
	; D154: the two waits of the hand never overlap a panel timer (the panel opens after the first, closes before the second)
	If _anim == 1
		AnimWait()
		Return
	ElseIf _anim == 3
		AnimCancel()
		Return
	EndIf
	; D144: the background page and the card are never open together; the page's timers come first when it is open
	If _pPending || _pAwaitingHello || _pVisible
		PortraitUpdate()
		Return
	EndIf
	If _pending
		; The view never became ready: wrong path or a backend that went away.
		_pending = False
		_wanted = False
		UnregisterForKey(EscCode)
		Debug.Trace("[AoT] Card: view not ready in time, plain card")
		ShowPlain()
		Return
	EndIf
	If _awaitingHello
		_awaitingHello = False
		_wanted = False
		HideQuiet()
		Debug.Trace("[AoT] Card: page did not answer in " + HelloSeconds + " s; focus NOT taken")
		ShowPlain()
		Return
	EndIf
	If !_visible
		Return
	EndIf
	; D154: with the world running (no pause, no time scale), a fight puts the card away. D184: so does death.
	If _animLive && Game.GetPlayer().IsDead()
		ClosePanel("death")
		Return
	EndIf
	If _animLive && Game.GetPlayer().IsInCombat()
		ClosePanel("combat")
		Return
	EndIf
	; D184: the card in the hand has the focus from the page's ready, as the full-screen card; the same watchdog
	If Lodestone.WebUIIsViewFocused(ViewId)
		Tick(WatchdogSeconds)
		Return
	EndIf
	; Lost the focus (panic key, load, a pausing menu). Do not ask it back.
	AoT_Core.Log("[AoT] Card: focus lost, closing the panel")
	ClosePanel("watchdog")
EndEvent

Function HideQuiet()
	Lodestone.WebUIClearFocus(ViewId)
	Lodestone.WebUIHide(ViewId)
	_visible = False
	UnregisterForKey(EscCode)
EndFunction

Function ClosePanel(String asVia)
	{asVia says who closed it: "key", "esc", "page", "watchdog", "combat", "death" (D184) or "unequip" (D154). The line is written
	only when there was something to close. D154: the card in the hand is put away after the panel hides.}
	Bool hadPanel = _visible || _awaitingHello || _anim == 1 || _anim == 2
	_wanted = False
	_awaitingHello = False
	UnregisterForKey(EscCode)
	UnregisterForAllMenus()
	If !_visible
		If hadPanel
			AoT_Core.Log("[AoT] Card: closed by " + asVia)
		EndIf
		AnimClose(asVia)
		Return
	EndIf
	HideQuiet()
	AoT_Core.Log("[AoT] Card: closed by " + asVia)
	AnimClose(asVia)
EndFunction

; ---------------------------------------------------------------------------
; D154: the card in the hand. Events of the behavior patch aotc (first-person
; 0_master): AoTCardOpen enters AoTCard_Inspect, whose entry clip annotates
; AoTCardReady; AoTCardClose goes to AoTCard_Exit, whose clip annotates
; AoTCardHidden, which leaves AoTCard_Inspect and notifies AnimObjectUnequip;
; AoTCardCancel leaves AoTCard_Inspect at once (AnimObjectUnequip only).
; AoTCardTapAt plays the tap blended at the floats AoTCardTapU/V; its clips
; annotate AoTCardTouch (contact) and AoTCardTapDone (back to the hold).
; ---------------------------------------------------------------------------

Bool Function AnimStart()
	{False = this opening has no card in the hand: a camera that is neither first nor third person (horse, furniture,
	free camera...), or a fight. Never UnequipAll: a drawn weapon is sheathed, the rest of the equipment stays.}
	_animLive = False
	_tapBusy = False
	_quad = ""
	_fitTold = False
	Actor p = Game.GetPlayer()
	Int cam = Game.GetCameraState()
	; D159: a close that just gave third person back leaves the camera on its way there (6 is the transition, and the
	; state can still read 0): this opening comes from third person, so its close gives third person back again.
	Bool backing = _thirdBackAt > 0.0 && Utility.GetCurrentRealTime() - _thirdBackAt < ThirdBackSeconds
	If cam == 6 && backing
		cam = 9
	EndIf
	If cam != 0 && cam != 8 && cam != 9
		Debug.Trace("[AoT] Card: anim skipped, camera=" + cam)
		Return False
	EndIf
	If p.IsInCombat()
		Debug.Trace("[AoT] Card: anim skipped, in combat")
		Return False
	EndIf
	; D159: the card goes to a free left hand only; a torch stays lit when the weapons are sheathed
	If p.GetEquippedItemType(0) == 11
		Debug.Trace("[AoT] Card: anim skipped, the left hand holds a torch")
		Return False
	EndIf
	; D184: from here to the put-away the player does not walk nor turn, so the arm comes up with the camera still
	Lock()
	_closeVia = ""
	_anim = 1
	_animThird = cam != 0 || backing
	Bool drawn = p.IsWeaponDrawn()
	If drawn
		p.SheatheWeapon()
		Float t0 = Utility.GetCurrentRealTime()
		While p.IsWeaponDrawn() && Utility.GetCurrentRealTime() - t0 < SheatheSeconds && _wanted
			Utility.Wait(0.1)
		EndWhile
	EndIf
	If _animThird
		Game.ForceFirstPerson()
		Float t1 = Utility.GetCurrentRealTime()
		While Game.GetCameraState() != 0 && Utility.GetCurrentRealTime() - t1 < CameraSeconds && _wanted
			Utility.Wait(0.05)
		EndWhile
	EndIf
	If !_wanted
		; closed while the weapon or the camera moved: nothing reached the graph yet
		_anim = 0
		Unlock(_closeVia + " early")
		AnimCamera()
		Return True
	EndIf
	; Registered at every opening, after the camera reached first person
	Bool reg = RegisterForAnimationEvent(p, "AoTCardReady")
	RegisterForAnimationEvent(p, "AoTCardHidden")
	RegisterForAnimationEvent(p, "AoTCardTouch")
	RegisterForAnimationEvent(p, "AoTCardTapDone")
	RegisterForAnimationEvent(p, "AnimObjectUnequip")
	; D164: the entry clip's own events, and whether the patch is in this graph at all
	RegisterForAnimationEvent(p, "AnimObjLoad")
	RegisterForAnimationEvent(p, "AnimObjDraw")
	_animLoadAt = 0.0
	_animDrawAt = 0.0
	_animLeftAt = 0.0
	_animResent = False
	_animWaited = False
	_animLoadWaited = False
	_animGraph = False
	_animAt = Utility.GetCurrentRealTime()
	Debug.SendAnimationEvent(p, "AoTCardOpen")
	; Always on, like the key lines: one per opening, the line the bench reads. D166: seen = an entry clip ran since the
	; last load; what THIS opening's graph does is the "anim graph took" line.
	Debug.Trace("[AoT] Card: anim open camera=" + cam + " third=" + _animThird + " sheathed=" + drawn + " registered=" + reg + " nowCamera=" + Game.GetCameraState() + " seen=" + _graphSeen)
	Tick(AnimReadySeconds)
	Return True
EndFunction

Event OnAnimationEvent(ObjectReference akSource, String asEventName)
	If akSource != Game.GetPlayer()
		Return
	EndIf
	Float dt = Utility.GetCurrentRealTime() - _animAt
	If asEventName == "AoTCardReady"
		If _anim == 0
			; D159: the card reached the hand after the deadline gave the panel to the full screen: send it away
			Debug.SendAnimationEvent(Game.GetPlayer(), "AoTCardCancel")
			Debug.Trace("[AoT] Card: anim late ready, card sent away")
			Return
		EndIf
		If _anim != 1
			Return
		EndIf
		Debug.Trace("[AoT] Card: anim ready dt=" + dt)
		_graphSeen = True
		If _animDrawAt == 0.0
			; D177: the entry clip draws the card at 0.2 s; a Ready without that draw is a hand with no card in it (a
			; generator that dropped the clip triggers, F17e9c3): the page is not laid over an empty hand
			AnimFallback(True)
			Return
		EndIf
		AnimReached()
	ElseIf asEventName == "AnimObjDraw" || asEventName == "AnimObjLoad"
		; D164: the entry clip ran (these are its own triggers, at 0.04 and 0.2 s). D166: the proof the patch is there.
		If _anim == 1
			If asEventName == "AnimObjDraw" && _animDrawAt == 0.0
				_animDrawAt = Utility.GetCurrentRealTime()
			ElseIf asEventName == "AnimObjLoad" && _animLoadAt == 0.0
				_animLoadAt = Utility.GetCurrentRealTime()
			EndIf
			_graphSeen = True
			AnimTook(asEventName, dt)
		EndIf
		AoT_Core.Log("[AoT] Card: anim " + asEventName + " dt=" + dt + " anim=" + _anim)
	ElseIf asEventName == "AoTCardTouch"
		Debug.Trace("[AoT] Card: anim touch dt=" + (Utility.GetCurrentRealTime() - _tapAt))
	ElseIf asEventName == "AoTCardTapDone"
		_tapBusy = False
		Debug.Trace("[AoT] Card: anim tapdone dt=" + (Utility.GetCurrentRealTime() - _tapAt))
	ElseIf asEventName == "AoTCardHidden" || asEventName == "AnimObjectUnequip"
		If _anim == 3
			AnimDone(asEventName)
		ElseIf _anim == 2 && asEventName == "AnimObjectUnequip"
			; The card left the hand by itself (another animation took the graph): the panel has nothing under it
			Debug.Trace("[AoT] Card: anim card left the hand, closing")
			ClosePanel("unequip")
		ElseIf _anim == 1 && asEventName == "AnimObjectUnequip"
			If _animLoadAt == 0.0 && _animDrawAt == 0.0
				; D166: before the entry clip's first trigger nothing of the card is in the hand: this is the state the
				; graph left for AoTCardOpen (the patch sends AnimObjectUnequip only when leaving AoTCard_Inspect)
				AoT_Core.Log("[AoT] Card: anim AnimObjectUnequip before the clip, dt=" + dt)
				AnimTook("AnimObjectUnequip", dt)
			ElseIf _animLeftAt == 0.0
				; D164: it left after the clip began, before the Ready; AnimWait opens it once more
				_animLeftAt = Utility.GetCurrentRealTime()
				Debug.Trace("[AoT] Card: anim card left the hand before the ready, dt=" + dt)
			EndIf
		EndIf
	EndIf
EndEvent

Function AnimReached()
	{The card is in the hand: the panel follows (D154). From the clip's AoTCardReady, or from AnimWait (D164).}
	_anim = 2
	If !_wanted
		AnimClose("late")
		Return
	EndIf
	_animLive = True
	ReadFov()
	MeasureAgain()
	If _anim != 2 || !_wanted
		; D191: put away while a reading waited; the close already sent the card away, and no view opens
		Return
	EndIf
	OpenView()
	TellPlaced()
EndFunction

Function MeasureAgain()
	{D191: MeasureCard, and again while it fails, up to MeasureTries readings MeasureGap s apart, before the view opens.
	D192: no good reading, the page goes to the last measured quad of this load; none yet, to its own fixed quad.}
	_placedTries = 0
	_placedMisses = ""
	_placedBy = ""
	While _placedTries < MeasureTries
		If _placedTries > 0
			Utility.Wait(MeasureGap)
			If _anim != 2 || !_wanted
				Return
			EndIf
		EndIf
		_placedTries += 1
		MeasureCard()
		If _placedWhy == ""
			_placedBy = "measured"
			If _placedTries > 1
				_placedBy = "remeasured"
			EndIf
			_lastGoodQuad = _quad
			Return
		EndIf
		_placedMisses += MissNote()
	EndWhile
	If _lastGoodQuad != ""
		_quad = _lastGoodQuad
		_placedBy = "last"
	Else
		_placedBy = "fixed"
	EndIf
EndFunction

String Function MissNote()
	{D191: one failed reading for the anim placed line: the reason, where the card node was, and where the AnimObjectA
	bone it hangs from was at the same moment (a node far from its bone is a node read off its place).}
	Float[] bone = new Float[3]
	String t = _placedWhy + "@" + _placedAt[0] + "," + _placedAt[1] + "," + _placedAt[2]
	If NetImmerse.GetNodeWorldPosition(Game.GetPlayer(), CardBone, bone, True)
		t += "@bone=" + bone[0] + "," + bone[1] + "," + bone[2]
	Else
		t += "@bone=none"
	EndIf
	Return t + ";"
EndFunction

Function ReadFov()
	{D181: Camera.psc declares GetFirstPersonFieldOfView and GetWorldFieldOfView, but the SKSE builds of this runtime
	bind neither (the names are not in the DLL; each call logged an unbound native and returned 0, F17e9c4). The
	game's own setting is read through Utility.GetINIFloat, which SKSE binds. Out of range (0 when the setting is not
	found): the field of view the card itself showed, FovMesh. TellPlaced says which (fovBy=).}
	_placedFovIni = Utility.GetINIFloat(FovSetting)
	If _placedFovIni >= 20.0 && _placedFovIni <= 150.0
		_placedFov = _placedFovIni
		_placedFovBy = "ini"
	Else
		_placedFov = FovMesh
		_placedFovBy = "mesh"
	EndIf
EndFunction

Function MeasureCard()
	{D178: where the 3D card is on the screen, read at the Ready off the first person skeleton (SKSE NetImmerse): the
	eye is the world position of Camera1st, the view turns with the player's heading and pitch, and each corner of the
	card's face goes into the eye's frame as two tangents (right and up over the distance ahead). The page turns them
	into pixels with its own width and the field of view, so the pose of the clip, the eye's height and the pitch all
	come from the game and no screen is assumed. A node not read, a corner behind the eye or out of any view, or a face
	too small or turned over (D186), fails this reading (_placedWhy) and MeasureAgain decides (D191, D192). Only what the corners need is
	read here, before the view opens. D184: once per opening, at the Ready, with the camera held still since the key.}
	_quad = ""
	_placedWhy = ""
	_placedAt = new Float[3]
	_placedRot = new Float[9]
	_placedEye = new Float[3]
	Actor p = Game.GetPlayer()
	_placedNode = CardNode
	If !NetImmerse.GetNodeWorldPosition(p, _placedNode, _placedAt, True)
		_placedNode = CardBone
		If !NetImmerse.GetNodeWorldPosition(p, _placedNode, _placedAt, True)
			_placedWhy = "no card node"
		EndIf
	EndIf
	If _placedWhy == "" && !NetImmerse.GetNodeWorldRotationMatrix(p, _placedNode, _placedRot, True)
		_placedWhy = "card unturned"
	EndIf
	If _placedWhy == "" && !NetImmerse.GetNodeWorldPosition(p, EyeNode, _placedEye, True)
		_placedWhy = "no eye node"
	EndIf
	_placedYaw = p.GetAngleZ()
	_placedPitch = p.GetAngleX()
	If _placedWhy == "" && (_placedFov < 20.0 || _placedFov > 150.0)
		_placedWhy = "fov " + _placedFov
	EndIf
	; The view: ahead (heading from +Y toward +X, pitch down when positive), right, and up = right x ahead
	Float cx = Math.Cos(_placedPitch)
	Float sx = Math.Sin(_placedPitch)
	Float cz = Math.Cos(_placedYaw)
	Float sz = Math.Sin(_placedYaw)
	Float fx = sz * cx
	Float fy = cz * cx
	Float fz = -sx
	Float ux = sz * sx
	Float uy = cz * sx
	Float[] at = _placedAt
	Float[] rot = _placedRot
	Float[] eye = _placedEye
	Float[] tan = new Float[8]
	String tans = ""
	Int i = 0
	While _placedWhy == "" && i < 4
		; top-left, top-right, bottom-right, bottom-left of the face, in the root's frame
		Float lx = CardHalfW
		If i == 0 || i == 3
			lx = -CardHalfW
		EndIf
		Float lz = CardHalfH
		If i >= 2
			lz = -CardHalfH
		EndIf
		; world = position + rotation (row-major) x local; then from the eye
		Float dx = at[0] + rot[0] * lx + rot[2] * lz - eye[0]
		Float dy = at[1] + rot[3] * lx + rot[5] * lz - eye[1]
		Float dz = at[2] + rot[6] * lx + rot[8] * lz - eye[2]
		Float ahead = dx * fx + dy * fy + dz * fz
		If ahead < 1.0
			_placedWhy = "corner " + i + " behind the eye"
		Else
			Float a = (dx * cz - dy * sz) / ahead
			Float b = (dx * ux + dy * uy + dz * cx) / ahead
			If a > 3.0 || a < -3.0 || b > 3.0 || b < -3.0
				_placedWhy = "corner " + i + " out of view"
			Else
				tan[2 * i] = a
				tan[2 * i + 1] = b
				tans += "," + a + "," + b
			EndIf
		EndIf
		i += 1
	EndWhile
	If _placedWhy == ""
		; D186: across = the top and bottom edges, down = the left and right edges, each the mean of the two
		Float across = (tan[2] - tan[0] + tan[4] - tan[6]) / 2.0
		Float down = (tan[1] - tan[7] + tan[3] - tan[5]) / 2.0
		If across < MinTanW || down < MinTanH
			_placedWhy = "card too small or turned over, " + across + " x " + down
		EndIf
	EndIf
	If _placedWhy == ""
		_quad = "" + _placedFov + tans
	EndIf
EndFunction

Function TellPlaced()
	{D179: always on, one line per opening in the hand, after the view opened: what the page was given (quad, or the
	fixed quad and why) and the raw reading behind it, with the eye node's own turn, the world field of view and the
	player's scale beside it, so a card drawn elsewhere can be pinned to a convention.}
	Actor p = Game.GetPlayer()
	Float[] eyeRot = new Float[9]
	NetImmerse.GetNodeWorldRotationMatrix(p, EyeNode, eyeRot, True)
	; D191, D192: measured (the first reading), remeasured (a later one), last (the last measured quad of this load)
	; or fixed (the page's own), the last two with the reason of the last failed reading
	String by = _placedBy
	If by == "last" || by == "fixed"
		by += " (" + _placedWhy + ")"
	EndIf
	Float drew = 0.0
	If _animDrawAt > 0.0
		drew = _animDrawAt - _animAt
	EndIf
	Float[] at = _placedAt
	Float[] rot = _placedRot
	Float[] eye = _placedEye
	String t = "[AoT] Card: anim placed by=" + by + " tries=" + _placedTries + " node=" + _placedNode + " draw=" + drew + " fov1st=" + _placedFov
	t += " fovBy=" + _placedFovBy + " fovIni=" + _placedFovIni + " fovWorldIni=" + Utility.GetINIFloat(FovWorldSetting)
	t += " yaw=" + _placedYaw + " pitch=" + _placedPitch
	t += " scale=" + p.GetScale() + " eye=" + eye[0] + "," + eye[1] + "," + eye[2] + " card=" + at[0] + "," + at[1]
	t += "," + at[2] + " quad=" + _quad + " cardRot=" + rot[0] + "," + rot[1] + "," + rot[2] + "," + rot[3] + ","
	t += rot[4] + "," + rot[5] + "," + rot[6] + "," + rot[7] + "," + rot[8] + " eyeRot=" + eyeRot[0] + "," + eyeRot[1]
	t += "," + eyeRot[2] + "," + eyeRot[3] + "," + eyeRot[4] + "," + eyeRot[5] + "," + eyeRot[6] + "," + eyeRot[7] + ","
	t += eyeRot[8]
	t += " misses=" + _placedMisses
	Debug.Trace(t)
EndFunction

Function AnimTook(String asBy, Float afDt)
	{D166: the first thing this opening's graph sent after AoTCardOpen. A graph without the aotc patch does not know the
	event and sends nothing. (D164 read AoTCardTapU back instead; it read 0 outside the hold, f17e8bc5.)}
	If _animGraph
		Return
	EndIf
	_animGraph = True
	; Always on: the bench reads it, one per opening
	Debug.Trace("[AoT] Card: anim graph took the open, by=" + asBy + " dt=" + afDt)
EndFunction

Function AnimWait()
	{D164: AnimReadySeconds without AoTCardReady. D166: the graph's own answer to this opening decides. It sent nothing
	and no entry clip ran since the load: no patch, the full-screen card, as in 1.2. It sent nothing but a clip ran
	before: this AoTCardOpen was lost, sent once more. The card drawn (AnimObjDraw) and still there: the entry clip ran
	and its Ready is late or lost, so the graph is told it once the clip had time to end. The clip began and has not
	drawn yet: it is late, waited for until its Ready is due. The graph took the event and no clip began (the clip not
	ready to play yet), or the card gone before the Ready: AoTCardOpen once more, with a new wait.}
	Float now = Utility.GetCurrentRealTime()
	Float dt = now - _animAt
	Actor p = Game.GetPlayer()
	If !_animGraph && !_graphSeen
		AnimFallback()
		Return
	EndIf
	If _animDrawAt > 0.0 && _animLeftAt == 0.0
		Float rest = _animDrawAt + AnimDrawToReady - now
		If rest > 0.05 && !_animWaited
			_animWaited = True
			Tick(rest)
			Return
		EndIf
		Debug.SendAnimationEvent(p, "AoTCardReady")
		; Always on: the bench reads it, one per opening that needed it
		Debug.Trace("[AoT] Card: anim ready told, the clip drew the card without AoTCardReady, draw=" + (_animDrawAt - _animAt) + " dt=" + dt)
		AnimReached()
		Return
	EndIf
	If _animLoadAt > 0.0 && _animLeftAt == 0.0 && !_animLoadWaited
		Float due = _animLoadAt + AnimLoadToReady - now
		If due > 0.05
			_animLoadWaited = True
			AoT_Core.Log("[AoT] Card: anim clip began late, load=" + (_animLoadAt - _animAt) + " waiting " + due + " s")
			Tick(due)
			Return
		EndIf
	EndIf
	If !_animResent
		Float drew = -1.0
		If _animDrawAt > 0.0
			drew = _animDrawAt - _animAt
		EndIf
		Float left = -1.0
		If _animLeftAt > 0.0
			left = _animLeftAt - _animAt
		EndIf
		Float began = -1.0
		If _animLoadAt > 0.0
			began = _animLoadAt - _animAt
		EndIf
		_animResent = True
		_animLoadAt = 0.0
		_animDrawAt = 0.0
		_animLeftAt = 0.0
		_animWaited = False
		_animLoadWaited = False
		Debug.SendAnimationEvent(p, "AoTCardOpen")
		; Always on: the bench reads it. D166: took = the graph answered the first AoTCardOpen.
		Debug.Trace("[AoT] Card: anim open again, took=" + _animGraph + " load=" + began + " draw=" + drew + " left=" + left + " dt=" + dt)
		Tick(AnimReadySeconds)
		Return
	EndIf
	AnimFallback()
EndFunction

Function AnimFallback(Bool abDrawless = False)
	{No AoTCardReady within AnimReadySeconds: no generated behavior with the aotc patch, or a graph that does not
	forward the annotation. The Cancel takes back a card that might be in the hand; the panel opens as in 1.2.
	abDrawless (D177): the Ready came and the card was never drawn.}
	_anim = 0
	_animLive = False
	Debug.SendAnimationEvent(Game.GetPlayer(), "AoTCardCancel")
	; D184: the full-screen card holds the player with its own focus
	Unlock("full-screen")
	AnimUnregister()
	; D159: a Ready that comes late finds the card sent away (OnAnimationEvent)
	RegisterForAnimationEvent(Game.GetPlayer(), "AoTCardReady")
	AnimCamera()
	; D162: dt is the real wait; it says the deadline ran out and not an older tick
	If abDrawless
		; Always on: the line that tells a player's log the generated behavior lacks the clip triggers
		Debug.Trace("[AoT] Card: anim ready without AnimObjDraw, the card was not drawn: full-screen card (behavior generated without the clip triggers?) dt=" + (Utility.GetCurrentRealTime() - _animAt))
	Else
		Debug.Trace("[AoT] Card: anim no AoTCardReady in " + AnimReadySeconds + " s, full-screen card (behavior not generated?) dt=" + (Utility.GetCurrentRealTime() - _animAt) + " graph=" + _animGraph + " resent=" + _animResent)
	EndIf
	If _wanted
		OpenView()
	EndIf
EndFunction

Function AnimClose(String asVia)
	{The panel is hidden; the hand puts the card away. AoTCardClose goes to the exit clip from the entry or the hold.}
	If _anim != 1 && _anim != 2
		Return
	EndIf
	_anim = 3
	_animLive = False
	_closeVia = asVia
	_animAt = Utility.GetCurrentRealTime()
	Debug.SendAnimationEvent(Game.GetPlayer(), "AoTCardClose")
	Debug.Trace("[AoT] Card: anim close via=" + asVia)
	Tick(AnimHiddenSeconds)
EndFunction

Function AnimCancel()
	{No AoTCardHidden within AnimHiddenSeconds: the emergency exit of the graph, straight back to the default state.}
	Debug.SendAnimationEvent(Game.GetPlayer(), "AoTCardCancel")
	Debug.Trace("[AoT] Card: anim no AoTCardHidden in " + AnimHiddenSeconds + " s, AoTCardCancel sent")
	AnimDone("cancel")
EndFunction

Function AnimDone(String asBy)
	Float dt = Utility.GetCurrentRealTime() - _animAt
	_anim = 0
	_animLive = False
	_tapBusy = False
	AnimUnregister()
	Debug.Trace("[AoT] Card: anim away by=" + asBy + " dt=" + dt + " third=" + _animThird)
	; D184: the card is out of the hand: the controls back before the camera and before a kept press opens it again
	Unlock(_closeVia + " away=" + asBy)
	AnimCamera()
	; a view still being created when the card was put away gets its own wait back (the single timer was ours)
	If _pending
		Tick(HelloSeconds)
	EndIf
	; D166: a press kept while the card went away
	If _reopen
		_reopen = False
		Reopen()
	EndIf
EndFunction

Function Reopen()
	{D166: the card key went down while the hand put the card away, and no press took it back. The gates of a press
	again, since the world may have changed meanwhile; then the card, as from the key.}
	Bool busy = _visible || _awaitingHello || _pending || _anim != 0 || _pVisible || _pAwaitingHello || _pPending || _pBusy
	Bool inMenu = Utility.IsInMenuMode()
	Bool inText = UI.IsTextInputEnabled()
	If busy || inMenu || inText || !AoT_Core.IsMember()
		Debug.Trace("[AoT] Card: reopen dropped, busy=" + busy + " menuMode=" + inMenu + " textInput=" + inText)
		Return
	EndIf
	; Always on: the bench reads it
	Debug.Trace("[AoT] Card: reopen after the put-away")
	OpenCard()
EndFunction

Function Lock()
	{D184: the card in the hand holds the player still from the key to the put-away, so the arm comes up and the card is
	measured with the camera still (the Ready), and the page stays over it. Only what this script gives back is taken:
	walking, looking, sneaking and activating. Fighting stays (the weapon is sheathed by AnimStart, and the focus from the
	page's ready takes the keys anyway), and so do the menus (one over the card closes it, OnMenuOpen) and the camera
	switch (AnimStart and AnimCamera move the camera themselves).}
	If _locked
		Return
	EndIf
	Game.DisablePlayerControls(True, False, False, True, True, False, True, False, 0)
	_locked = True
	_lockAt = Utility.GetCurrentRealTime()
	; Always on: one per opening in the hand, with the state read back
	Debug.Trace("[AoT] Card: lock on movement=" + Game.IsMovementControlsEnabled() + " looking=" + Game.IsLookingControlsEnabled())
EndFunction

Function Unlock(String asBy)
	{D184: the controls Lock took, and only those, given back. asBy: the close that led here (ClosePanel's asVia) and what
	ended it (the away, early, full-screen or load).}
	If !_locked
		Return
	EndIf
	_locked = False
	Game.EnablePlayerControls(True, False, False, True, True, False, True, False, 0)
	; Always on: one per lock, the path that gave the controls back
	Debug.Trace("[AoT] Card: lock off by=" + asBy + " held=" + (Utility.GetCurrentRealTime() - _lockAt) + " movement=" + Game.IsMovementControlsEnabled() + " looking=" + Game.IsLookingControlsEnabled())
EndFunction

Function AnimCamera()
	{Third person back, only when this opening took it. D159: asked again once if the camera is still in first person
	after CameraSeconds, unless a new opening began meanwhile.}
	If !_animThird
		Return
	EndIf
	_animThird = False
	Float t0 = Utility.GetCurrentRealTime()
	_thirdBackAt = t0
	Game.ForceThirdPerson()
	While Game.GetCameraState() == 0 && Utility.GetCurrentRealTime() - t0 < CameraSeconds && _anim == 0
		Utility.Wait(0.05)
	EndWhile
	Int cam = Game.GetCameraState()
	If cam == 0 && _anim == 0
		Game.ForceThirdPerson()
		_thirdBackAt = Utility.GetCurrentRealTime()
	EndIf
	; Always on: the line the bench reads, one per third person given back
	Debug.Trace("[AoT] Card: anim camera back cam=" + cam + " now=" + Game.GetCameraState())
EndFunction

Function AnimUnregister()
	Actor p = Game.GetPlayer()
	UnregisterForAnimationEvent(p, "AoTCardReady")
	UnregisterForAnimationEvent(p, "AoTCardHidden")
	UnregisterForAnimationEvent(p, "AoTCardTouch")
	UnregisterForAnimationEvent(p, "AoTCardTapDone")
	UnregisterForAnimationEvent(p, "AnimObjectUnequip")
	UnregisterForAnimationEvent(p, "AnimObjLoad")
	UnregisterForAnimationEvent(p, "AnimObjDraw")
EndFunction

Function TapAt(String asAct)
	{The page's "tap-at|U|V": the point of the 3D card under the click, in the card's UV (0 to 1). The finger goes
	there: the two floats, read back, then AoTCardTapAt. One tap at a time; the buy click does not depend on it.
	D187: with the page drawn over the card (PageOnCardTexture False) no tap plays: one always-on line per click.}
	String[] parts = PapyrusUtil.StringSplit(asAct, "|")
	If parts.Length != 3
		Return
	EndIf
	If !PageOnCardTexture
		; Always on: the line the bench reads, one per click on the star field of the card in the hand
		Debug.Trace("[AoT] Card: click u=" + parts[1] + " v=" + parts[2] + " anim=" + _anim + " tap=skipped (page over card)")
		Return
	EndIf
	If _anim != 2
		Return
	EndIf
	Float now = Utility.GetCurrentRealTime()
	If _tapBusy && now - _tapAt < AnimTapSeconds
		AoT_Core.Log("[AoT] Card: tap-at ignored, a tap is playing")
		Return
	EndIf
	Float u = parts[1] as Float
	Float v = parts[2] as Float
	Float su = PapyrusUtil.ClampFloat(u, TapUMin, TapUMax)
	Float sv = PapyrusUtil.ClampFloat(v, TapVMin, TapVMax)
	Actor p = Game.GetPlayer()
	p.SetAnimationVariableFloat("AoTCardTapU", su)
	p.SetAnimationVariableFloat("AoTCardTapV", sv)
	Float ru = p.GetAnimationVariableFloat("AoTCardTapU")
	Float rv = p.GetAnimationVariableFloat("AoTCardTapV")
	Debug.Trace("[AoT] Card: tap-at u=" + u + " v=" + v + " sent=" + su + "," + sv + " read=" + ru + "," + rv)
	If ru < su - 0.0001 || ru > su + 0.0001 || rv < sv - 0.0001 || rv > sv + 0.0001
		Debug.Trace("[AoT] Card: tap-at readback differs, no tap (behavior without the floats?)")
		Return
	EndIf
	_tapBusy = True
	_tapAt = now
	Debug.SendAnimationEvent(p, "AoTCardTapAt")
EndFunction

Int Function BrowserKeyCode(Int aiScanCode)
	{DirectX scan code to the browser keyCode the page sees: F1-F10 (59-68) are
	112-121, F11/F12 (87/88) are 122/123. 0 = unknown, the page then keeps Esc only.}
	If aiScanCode >= 59 && aiScanCode <= 68
		Return aiScanCode + 53
	ElseIf aiScanCode == 87 || aiScanCode == 88
		Return aiScanCode + 35
	EndIf
	Return 0
EndFunction

; ---------------------------------------------------------------------------
; D144: the portrait key and the background page (portrait.html). The page
; never changes anything by itself: confirm is the only path to a new
; portrait or background, and it goes through AoT_Portrait.Confirm.
; ---------------------------------------------------------------------------

Function NewLoad()
	{From the settings quest at every load (AoT_MCM.OnGameReload): a save from before 1.3 never registered the portrait
	key, and a capture never spans a load.}
	_pBusy = False
	; D184: a save taken with the card in the hand keeps the controls taken (the game saves them): given back here
	If _locked
		_lockAt = 0.0
		Unlock("load")
	EndIf
	_hintShown = False
	_thirdBackAt = 0.0
	_tickDue = 0.0
	; D165: nor a card waiting for a portrait
	_cardAfter = False
	; D166: nor a press kept through an away; the graph proves itself again after a load
	_reopen = False
	_graphSeen = False
	; D192: the last measured quad belongs to the load it was measured in
	_lastGoodQuad = ""
	; D154: a card in the hand never spans a load; the graph of the loaded game has none
	If _anim != 0
		Debug.Trace("[AoT] Card: anim state " + _anim + " reset at load")
		_anim = 0
		_animLive = False
		_tapBusy = False
		_animThird = False
		AnimUnregister()
	EndIf
	ApplyKey()
EndFunction

Bool Function PortraitFirst()
	{D165: True when the card key went to the portrait page instead of the card: a member with no confirmed portrait
	who never confirmed the page, where one can be taken (Lodestone 1.53.0 and a panel). Below that the card opens as
	before: the silhouette, or the plain card without a panel.}
	If AoT_Portrait.ConfirmedFile() != "" || StorageUtil.GetIntValue(None, PConfirmedKey, 0) == 1
		Return False
	EndIf
	If !AoT_Portrait.Available() || !CanUsePanel()
		Return False
	EndIf
	; Always on: the line the bench reads, one per redirected press
	Debug.Trace("[AoT] Card: no portrait yet, the portrait page first")
	_cardAfter = True
	PortraitPressed()
	If !_pVisible && !_pAwaitingHello && !_pPending
		; the page did not get to open (its own line says why): no confirm will come
		_cardAfter = False
	EndIf
	Return True
EndFunction

Function CardAfterPortrait()
	{D165: the confirm of a page the card key opened: the card opens, in the hand where it can. Without a portrait (the
	background alone confirmed after a refused capture) it opens with the silhouette, so a setup where the capture is
	always refused never leaves the card key dead.}
	String f = AoT_Portrait.ConfirmedFile()
	; As for "take another": the wait counts only once the game left the menu mode the page's focus held
	Utility.Wait(RetakeSettle)
	If _visible || _awaitingHello || _pending || _anim != 0 || _pVisible || _pAwaitingHello || _pPending || _pBusy
		Debug.Trace("[AoT] Card: portrait confirmed, the card not opened, visible=" + _visible + " anim=" + _anim + " page=" + _pVisible)
		Return
	EndIf
	If !AoT_Core.IsMember()
		Return
	EndIf
	; Always on: the line the bench reads
	Debug.Trace("[AoT] Card: portrait confirmed, the card opens, file=" + f)
	OpenCard()
EndFunction

Function PortraitKeyDown()
	{The portrait key. With the page open it cancels (the key closes what it opened, D013); otherwise the guards of the
	card key, in the same order.}
	If _pBusy
		Debug.Trace("[AoT] Portrait: key ignored, a capture is running")
		Return
	EndIf
	If _pVisible || _pAwaitingHello
		PortraitClose("key")
		Return
	EndIf
	If _visible || _awaitingHello || _pending
		Debug.Trace("[AoT] Portrait: key ignored, the card is open")
		Return
	EndIf
	Bool inMenu = Utility.IsInMenuMode()
	Bool inText = UI.IsTextInputEnabled()
	If inMenu || inText
		Debug.Trace("[AoT] Portrait: key ignored, menuMode=" + inMenu + " textInput=" + inText)
		Return
	EndIf
	If !AoT_Core.CardModifierHeld()
		Debug.Trace("[AoT] Portrait: key ignored, modifier " + AoT_Core.CardModifierName(AoT_Core.CardModifier()) + " not held")
		Return
	EndIf
	If !AoT_Core.IsMember()
		Debug.Notification("You are not a member of the Adventurers Guild.")
		Return
	EndIf
	PortraitPressed()
EndFunction

Function PortraitPressed()
	{What the key does past its guards (the bench calls this directly): without a confirmed portrait, one capture and
	then the page; with one, the page alone, which has "take another".}
	If _pBusy || _pVisible || _pAwaitingHello || _pPending
		Return
	EndIf
	If !AoT_Portrait.Available()
		Debug.Notification("The portrait needs Lodestone 1.53.0 or newer.")
		Debug.Trace("[AoT] Portrait: Lodestone " + Lodestone.GetVersion() + " below " + AoT_Portrait.MinVersion() + ", no capture")
		Return
	EndIf
	If !CanUsePanel()
		Debug.Notification("The portrait page needs Prisma UI or Magelight UI.")
		Debug.Trace("[AoT] Portrait: panel not available, no capture")
		Return
	EndIf
	_pNew = ""
	_pReason = ""
	If AoT_Portrait.ConfirmedFile() == ""
		PortraitTake()
	EndIf
	OpenPortraitPage()
EndFunction

Function PortraitTake()
	{One capture to the pending key, never repeated. A refusal keeps the new file of an earlier try, if any, and leaves
	the reason for the page.}
	_pBusy = True
	Int cam = Game.GetCameraState()
	Float t0 = Utility.GetCurrentRealTime()
	String got = AoT_Portrait.Take()
	If got != ""
		_pNew = got
		_pReason = ""
	Else
		_pReason = AoT_Portrait.RefusalText(cam)
		got = "refused"
	EndIf
	_pBusy = False
	; Always on: one line per capture, the line the bench reads
	Debug.Trace("[AoT] Portrait: take " + got + " camera=" + cam + " slot=" + AoT_Portrait.PendingSlot() + " in " + (Utility.GetCurrentRealTime() - t0) + " s")
EndFunction

Function OpenPortraitPage()
	; An orphan from before a load: the view outlives the load, the flags do not.
	If !_pVisible && Lodestone.WebUIIsViewReady(PViewId) && Lodestone.WebUIIsViewVisible(PViewId)
		Lodestone.WebUIClearFocus(PViewId)
		Lodestone.WebUIHide(PViewId)
	EndIf
	_pWanted = True
	If Lodestone.WebUIIsViewReady(PViewId)
		PortraitOpenNow()
		Return
	EndIf
	If _pPending
		Return
	EndIf
	; Register BEFORE asking, as for the card
	RegisterForModEvent(EvtReady, "OnCardReady")
	_pPending = True
	Tick(HelloSeconds)
	If !Lodestone.WebUICreateView(PViewId, PViewPath)
		_pPending = False
		_pWanted = False
		Debug.Trace("[AoT] Portrait: WebUICreateView refused " + PViewPath)
		Debug.Notification("The portrait page could not open.")
		Return
	EndIf
	Debug.Trace("[AoT] Portrait: WebUICreateView accepted " + PViewPath)
EndFunction

Function PortraitReady()
	If !_pPending
		Return
	EndIf
	_pPending = False
	RegisterForModEvent(EvtPAction, "OnPortraitAction")
	RegisterForModEvent(EvtPLog, "OnPortraitLog")
	Lodestone.WebUIRegisterListener(PViewId, FnPAction, EvtPAction)
	Lodestone.WebUIRegisterListener(PViewId, FnPLog, EvtPLog)
	If !_pWanted
		Return
	EndIf
	PortraitOpenNow()
EndFunction

Function PortraitOpenNow()
	{Show, payload, and the focus only after the page's "ready" (as OpenNow).}
	_pAwaitingHello = True
	_pPayloadSent = False
	RegisterForKey(EscCode)
	Tick(HelloSeconds)
	Lodestone.WebUIShow(PViewId)
	_pVisible = True
	String eol = StringUtil.AsChar(10)
	String text = "p_name|" + Game.GetPlayer().GetDisplayName() + eol
	text += "hotkey|" + BrowserKeyCode(AoT_Core.PortraitKey()) + eol
	text += "p_current|" + AoT_Portrait.ConfirmedFile() + eol
	text += "p_new|" + _pNew + eol
	text += "p_bg|" + AoT_Portrait.Background() + eol
	text += "p_reason|" + _pReason + eol
	; Always on: one per opening, so a bench can replay what the page was given
	Debug.Trace("[AoT] Portrait: payload " + PapyrusUtil.StringJoin(PapyrusUtil.StringSplit(text, eol), " ~ "))
	Lodestone.WebUICall(PViewId, FnPortrait, text)
	_pPayloadSent = True
EndFunction

Event OnPortraitAction(String asEvent, String asAction, Float afNum, Form akSender)
	PortraitAction(Unwrap(asAction))
EndEvent

Event OnPortraitLog(String asEvent, String asText, Float afNum, Form akSender)
	AoT_Core.Log("[AoT] Portrait page: " + Unwrap(asText))
EndEvent

Function PortraitAction(String asAction)
	{The page's buttons (the bench calls this directly with the same words): "ready-..", "confirm|<background>",
	"cancel", "retake", "close" (Esc or the key on the page).}
	If StringUtil.Find(asAction, "ready") == 0
		; D103: the page answers every payload with "ready"; the one that counts comes after ours
		If !_pAwaitingHello || !_pPayloadSent
			Return
		EndIf
		_pAwaitingHello = False
		If !Lodestone.WebUIFocusView(PViewId)
			Debug.Trace("[AoT] Portrait: WebUIFocusView refused")
			PortraitClose("focus refused")
			Debug.Notification("The portrait page could not take the focus.")
			Return
		EndIf
		Debug.Trace("[AoT] Portrait: page said " + asAction + ", focus taken")
		Tick(WatchdogSeconds)
		Return
	EndIf
	If _pBusy
		Debug.Trace("[AoT] Portrait: " + asAction + " ignored, a capture is running")
		Return
	EndIf
	If !_pVisible
		Return
	EndIf
	If StringUtil.Find(asAction, "confirm|") == 0
		AoT_Portrait.Confirm(_pNew, StringUtil.Substring(asAction, 8) as Int)
		; D165: any confirm, from either key, ends the card key's detour to this page
		StorageUtil.SetIntValue(None, PConfirmedKey, 1)
		Debug.Trace("[AoT] Portrait: confirmed new=" + _pNew + " bg=" + AoT_Portrait.Background() + " slot=" + AoT_Portrait.ConfirmedSlot() + " file=" + AoT_Portrait.ConfirmedFile())
		_pNew = ""
		PortraitClose("confirm")
	ElseIf StringUtil.Find(asAction, "retake") == 0
		PortraitRetake()
	ElseIf StringUtil.Find(asAction, "cancel") == 0 || StringUtil.Find(asAction, "close") == 0
		PortraitClose(asAction)
	EndIf
EndFunction

Function PortraitRetake()
	{"Take another": the page is hidden during the capture, so it is not in the picture and the native sees no menu,
	then shown again with the new picture (or the one before it and the reason). Nothing is kept until confirm.}
	_pBusy = True
	_pAwaitingHello = False
	PortraitHide()
	; Waits (real time) only once the game is out of the menu mode the focus left
	Utility.Wait(RetakeSettle)
	PortraitTake()
	If !_pWanted
		Return
	EndIf
	PortraitOpenNow()
EndFunction

Function PortraitHide()
	Lodestone.WebUIClearFocus(PViewId)
	Lodestone.WebUIHide(PViewId)
	_pVisible = False
EndFunction

Function PortraitClose(String asVia)
	{asVia: "key", "esc", "cancel", "close", "confirm", "watchdog" or "focus refused". Only "confirm" changed anything,
	before this call; a new picture not confirmed stays on disk under the pending key until the next capture there.}
	Bool had = _pVisible || _pAwaitingHello
	; D165: read and dropped first, so no path out of here keeps it
	Bool after = _cardAfter
	_cardAfter = False
	_pWanted = False
	_pAwaitingHello = False
	UnregisterForKey(EscCode)
	If _pVisible
		PortraitHide()
	EndIf
	If _pNew != ""
		Debug.Trace("[AoT] Portrait: the new picture " + _pNew + " was not kept")
	EndIf
	_pNew = ""
	_pReason = ""
	If had
		Debug.Trace("[AoT] Portrait: closed by " + asVia)
	EndIf
	If !after
		Return
	EndIf
	If asVia == "confirm"
		CardAfterPortrait()
	Else
		Debug.Trace("[AoT] Card: the portrait page closed by " + asVia + ", the card stays closed")
	EndIf
EndFunction

Function PortraitUpdate()
	{The page's share of OnUpdate: the wait for the view, the wait for the hello, the focus watchdog.}
	If _pPending
		_pPending = False
		_pWanted = False
		Debug.Trace("[AoT] Portrait: view not ready in time")
		Debug.Notification("The portrait page could not open.")
		Return
	EndIf
	If _pAwaitingHello
		Debug.Trace("[AoT] Portrait: page did not answer in " + HelloSeconds + " s; focus NOT taken")
		PortraitClose("hello timeout")
		Debug.Notification("The portrait page could not open.")
		Return
	EndIf
	If !_pVisible
		Return
	EndIf
	If Lodestone.WebUIIsViewFocused(PViewId)
		Tick(WatchdogSeconds)
		Return
	EndIf
	; Lost the focus (panic key, load, a pausing menu). Do not ask it back.
	PortraitClose("watchdog")
EndFunction

; ---------------------------------------------------------------------------
; Payload (read-only, rebuilt at every opening) and the plain card
; ---------------------------------------------------------------------------

String Function BuildPayload()
	{One "key|value" line per fact. The page compares keys case-insensitively
	because Papyrus literals come back in the spelling the string pool holds.}
	Int rank = AoT_Core.GetRank()
	Int step = AoT_Core.LadderStep(rank)
	Int done = 0
	Int failed = 0
	Int open = 0
	Int lost = 0
	Int[] doneByBand = new Int[6]
	Int total = AoT_Core.ContractCount()
	Int id = 1
	While id <= total
		Int cstate = AoT_Core.ContractState(id)
		If cstate == 2
			done += 1
			Int band = AoT_Core.ContractBand(id)
			If band >= 0 && band < 6
				doneByBand[band] = doneByBand[band] + 1
			EndIf
		ElseIf cstate == 3 || cstate == 4
			failed += 1
			Int delta = AoT_Core.ContractDelta(id)
			If delta < 0
				lost += -delta
			EndIf
		ElseIf cstate == 1
			open += 1
		EndIf
		id += 1
	EndWhile

	String eol = StringUtil.AsChar(10)
	String text = "c_name|" + Game.GetPlayer().GetDisplayName() + eol
	text += "hotkey|" + BrowserKeyCode(AoT_Core.CardKey()) + eol
	text += "c_level|" + Game.GetPlayer().GetLevel() + eol
	; D116: always sent, empty when there is no picture: the page goes back to the silhouette
	text += "c_portrait|" + _portrait + eol
	; D144: the confirmed background, drawn under the portrait (0 the card's yellow)
	text += "c_bg|" + AoT_Portrait.Background() + eol
	; D154: 1 = the card is in the hand and the page draws over it; 0 = the full-screen card of 1.2
	Int anim = 0
	If _animLive
		anim = 1
	EndIf
	text += "c_anim|" + anim + eol
	; D178: always sent, empty when not measured: the page then keeps the fixed quad
	text += "c_quad|" + _quad + eol
	text += "c_joined|" + AoT_Core.JoinedDay() + eol
	; Fase 16 etapa 5 (D113): the hold of the first hall; absent until a talk with an attendant has stamped it
	String joinHold = StorageUtil.GetStringValue(None, "aot_join_hold", "")
	If joinHold != ""
		text += "c_hold|" + joinHold + eol
	EndIf
	If PerkOk()
		text += "c_perkok|1" + eol
		text += "c_pp|" + PerkPoints() + eol
	Else
		text += "c_perkok|0" + eol
	EndIf
	text += "c_rank|" + rank + eol
	text += "c_maxrank|" + AoT_Core.MaxRank() + eol
	String mat = JsonUtil.StringListGet(AoT_Core.TablePath(), "aot_rank_material", rank)
	; Always sent, empty when the table has no entry: the page keeps the keys of the last payload.
	text += "c_mat|" + mat + eol
	text += "c_ficha|" + RankFichas(rank) + eol
	text += "c_points|" + AoT_Core.GetPoints() + eol
	text += "c_step|" + step + eol
	If AoT_Core.IsPromotionEligible()
		text += "c_exam|1" + eol
	Else
		text += "c_exam|0" + eol
	EndIf
	text += "c_done|" + done + eol
	text += "c_failed|" + failed + eol
	text += "c_open|" + open + eol
	text += "c_lost|" + lost + eol
	; D093: the last perks taken as the save holds them now; each tree read below may add to it
	text += "c_recent|" + StorageUtil.GetStringValue(None, RecentKey, "") + eol
	Int b = 0
	While b < 6
		Int paid = 0
		If AoT_Core.IsBandPaid(b)
			paid = 1
		EndIf
		text += "c_band" + b + "|" + paid + "," + doneByBand[b] + eol
		b += 1
	EndWhile
	Return text
EndFunction

String Function RankFichas(Int aiRank)
	{What the rank already unlocks, for the card: "band:points,..." for every band whose draw weight is above zero at this rank. Both numbers come from points.json at open time.}
	String out = ""
	Int b = 0
	While b <= AoT_Core.MaxBand()
		If AoT_Core.BandWeight(aiRank, b) > 0
			If out != ""
				out += ","
			EndIf
			out += b + ":" + AoT_Core.PointsForBand(b)
		EndIf
		b += 1
	EndWhile
	Return out
EndFunction

; ---------------------------------------------------------------------------
; Perk trees. Every read here is a Lodestone native: one call returns a
; whole tree, but HasPerk / IsPerkEligible are one call per perk, so the states
; are timed and traced, and a tree is pushed as soon as it is read.
; ---------------------------------------------------------------------------

Bool Function PerkOk()
	Return Lodestone.GetVersion() >= PerkMinVersion
EndFunction

Int Function PerkPoints()
	{The engine's unspent points; -1 (player not available) reads as 0.}
	Int pp = Lodestone.GetPerkPoints()
	If pp < 0
		Return 0
	EndIf
	Return pp
EndFunction

Int Function ResolveTrees()
	{Fills _skills with the skills to draw and returns how many. The chosen skills
	(MCM, D016) whose tree is loaded; with none, the five of highest level.}
	_skills = new String[5]
	Int n = 0
	Int slot = 0
	While slot < AoT_Core.CardSlots()
		String chosen = AoT_Core.GetCardTree(slot)
		If chosen != ""
			If Lodestone.GetPerkTreePerks(chosen).Length > 0
				_skills[n] = chosen
				n += 1
			EndIf
		EndIf
		slot += 1
	EndWhile
	If n > 0
		Return n
	EndIf

	String[] names = new String[18]
	Int[] levels = new Int[18]
	Int found = 0
	Int i = 0
	While i < AoT_Core.SkillCount()
		String nm = AoT_Core.SkillEnumName(i)
		If Lodestone.GetPerkTreePerks(nm).Length > 0
			names[found] = nm
			levels[found] = AoT_Core.SkillLevel(nm)
			found += 1
		EndIf
		i += 1
	EndWhile
	While n < 5 && n < found
		Int best = -1
		Int j = 0
		While j < found
			If names[j] != ""
				If best < 0
					best = j
				ElseIf levels[j] > levels[best]
					best = j
				EndIf
			EndIf
			j += 1
		EndWhile
		_skills[n] = names[best]
		names[best] = ""
		n += 1
	EndWhile
	Return n
EndFunction

Perk Function NextToBuy(Perk akHead)
	{A tree node is the first rank of a perk; later ranks hang on GetNextPerk. The
	perk to buy next is the one after the highest rank owned, the head when none is
	owned, None when the chain is complete. Sets _lastHighest (-1 when none owned).}
	_lastHighest = -1
	_lastOwned = None
	Perk target = akHead
	Perk cur = akHead
	Int pos = 0
	While cur != None && pos < 16
		If Lodestone.HasPerk(cur)
			_lastHighest = pos
			_lastOwned = cur
			target = cur.GetNextPerk()
		EndIf
		cur = cur.GetNextPerk()
		pos += 1
	EndWhile
	Return target
EndFunction

Int Function NodeState(Perk akHead, Int aiPoints)
	{0 locked, 1 can buy, 2 owned (chain complete), 3 partly owned and the next rank
	can be bought, 4 partly owned and it cannot.}
	Perk target = NextToBuy(akHead)
	_lastTarget = target
	Int highest = _lastHighest
	If target == None
		Return 2
	EndIf
	Bool canBuy = False
	If aiPoints > 0
		canBuy = Lodestone.IsPerkEligible(target)
	EndIf
	If highest >= 0
		If canBuy
			Return 3
		EndIf
		Return 4
	EndIf
	If canBuy
		Return 1
	EndIf
	Return 0
EndFunction

String Function BuildTree(Int aiSlot)
	{One column: skill, level, and per-node parallel lists. Names are joined by "^",
	numbers by ",". The index of a node is its position in GetPerkTreePerks.}
	String skill = _skills[aiSlot]
	Float t0 = Utility.GetCurrentRealTime()
	Perk[] perks = Lodestone.GetPerkTreePerks(skill)
	Int[] gx = Lodestone.GetPerkTreeGridX(skill)
	Int[] gy = Lodestone.GetPerkTreeGridY(skill)
	String[] pn = Lodestone.GetPerkTreeNames(skill)
	Int[] edges = Lodestone.GetPerkTreeEdges(skill)
	Int pp = PerkPoints()
	Int n = perks.Length

	; D094: the fine position of each node (HNAM / VNAM), same order as the grid. Older Lodestone, or a list that does
	; not match the tree: no offset keys are sent and the card draws on the grid alone.
	; (an array is never assigned, compared or passed as None in Papyrus: a Bool says whether the lists are usable)
	Bool hasOffset = False
	Float[] hx
	Float[] vy
	If Lodestone.GetVersion() >= OffsetMinVersion
		hx = Lodestone.GetPerkTreeOffsetX(skill)
		vy = Lodestone.GetPerkTreeOffsetY(skill)
		hasOffset = hx.Length == n && vy.Length == n
	Else
		AoT_Core.Log("[AoT] Card: Lodestone below 1.44.0, no perk offsets (grid only)")
	EndIf

	; D093: what the save saw at the last read of this tree, to find the ranks taken since (in or out of the card)
	; (first read of this skill, or a tree whose node count changed: only the picture is written, no entry)
	String seen = StorageUtil.GetStringValue(None, OwnedKey + skill, "")
	String[] before = PapyrusUtil.StringSplit(seen, ",")
	Bool compare = seen != "" && before.Length == n && n > 0
	String xs = ""
	String ys = ""
	String hs = ""
	String vs = ""
	String ss = ""
	String nm = ""
	String ds = ""
	String own = ""
	Int i = 0
	While i < n
		If i > 0
			xs += ","
			ys += ","
			hs += ","
			vs += ","
			ss += ","
			nm += "^"
			ds += "^"
			own += ","
		EndIf
		xs += gx[i]
		ys += gy[i]
		If hasOffset
			hs += hx[i]
			vs += vy[i]
		EndIf
		ss += NodeState(perks[i], pp)
		nm += pn[i]
		; the rank the player would take now; with the chain complete, the last one taken
		Perk shown = _lastTarget
		If shown == None
			shown = _lastOwned
		EndIf
		If shown == None
			shown = perks[i]
		EndIf
		ds += OneLine(PO3_SKSEFunctions.GetDescription(shown))
		Int ranks = _lastHighest + 1
		own += ranks
		If compare
			If ranks > (before[i] as Int)
				AddRecent(skill, pn[i], ranks)
			EndIf
		EndIf
		i += 1
	EndWhile
	StorageUtil.SetStringValue(None, OwnedKey + skill, own)
	String es = ""
	i = 0
	While i < edges.Length
		If i > 0
			es += ","
		EndIf
		es += edges[i]
		i += 1
	EndWhile

	String eol = StringUtil.AsChar(10)
	String k = "t" + aiSlot + "_"
	String text = "c_pp|" + pp + eol
	text += k + "skill|" + skill + eol
	text += k + "lvl|" + AoT_Core.SkillLevel(skill) + eol
	text += k + "n|" + n + eol
	text += k + "x|" + xs + eol
	text += k + "y|" + ys + eol
	If hasOffset
		text += k + "hx|" + hs + eol
		text += k + "vy|" + vs + eol
	EndIf
	text += k + "s|" + ss + eol
	text += k + "names|" + nm + eol
	text += k + "e|" + es + eol
	text += k + "desc|" + ds + eol
	text += "c_recent|" + StorageUtil.GetStringValue(None, RecentKey, "") + eol
	AoT_Core.Log("[AoT] Card: tree " + skill + " nodes=" + n + " edges=" + (edges.Length / 2) + " points=" + pp + " owned=" + own + " read in " + (Utility.GetCurrentRealTime() - t0) + " s")
	If AoT_Core.DebugLogOn()
		; D093: the whole payload on one line, so a bench can replay what the game really sent
		Debug.Trace("[AoT] Card: payload " + PapyrusUtil.StringJoin(PapyrusUtil.StringSplit(text, eol), " ~ "))
	EndIf
	Return text
EndFunction

String Function OneLine(String asText)
	{The payload is one "key|value" line per fact and "^" joins the nodes: a line break or a "^" in a perk's text
	becomes a space.}
	String out = asText
	String[] bad = new String[3]
	bad[0] = StringUtil.AsChar(10)
	bad[1] = StringUtil.AsChar(13)
	bad[2] = "^"
	Int j = 0
	While j < 3
		If StringUtil.Find(out, bad[j]) >= 0
			out = PapyrusUtil.StringJoin(PapyrusUtil.StringSplit(out, bad[j]), " ")
		EndIf
		j += 1
	EndWhile
	Return out
EndFunction

String Function RankSuffix(Int aiRanks)
	{"" for the first rank; " II" to " X" after it, the number past ten.}
	If aiRanks < 2
		Return ""
	EndIf
	String[] roman = new String[11]
	roman[2] = " II"
	roman[3] = " III"
	roman[4] = " IV"
	roman[5] = " V"
	roman[6] = " VI"
	roman[7] = " VII"
	roman[8] = " VIII"
	roman[9] = " IX"
	roman[10] = " X"
	If aiRanks <= 10
		Return roman[aiRanks]
	EndIf
	Return " " + aiRanks
EndFunction

Function AddRecent(String asSkill, String asPerk, Int aiRanks)
	{D093: puts "Skill:Perk" in front of the last perks taken and keeps at most RecentMax.}
	String entry = asSkill + ":" + OneLine(asPerk) + RankSuffix(aiRanks)
	String old = StorageUtil.GetStringValue(None, RecentKey, "")
	String joined = entry
	If old != ""
		joined = entry + "^" + old
	EndIf
	String[] parts = PapyrusUtil.StringSplit(joined, "^")
	String out = ""
	Int j = 0
	While j < parts.Length && j < RecentMax
		If j > 0
			out += "^"
		EndIf
		out += parts[j]
		j += 1
	EndWhile
	StorageUtil.SetStringValue(None, RecentKey, out)
	AoT_Core.Log("[AoT] Card: recent + " + entry)
EndFunction

Function BuyPerk(Int aiSlot, Int aiIndex)
	{A click on a node the page drew as buyable. The page decides nothing: the state
	is read again here, and TryBuyPerk re-checks everything. The trace line carries
	the points before and after the buy, and whether the perk is owned.}
	If !_visible || !PerkOk()
		Return
	EndIf
	If aiSlot < 0 || aiSlot >= _skillCount
		Debug.Trace("[AoT] Card: buy refused, bad column " + aiSlot)
		Return
	EndIf
	String skill = _skills[aiSlot]
	Perk[] perks = Lodestone.GetPerkTreePerks(skill)
	If aiIndex < 0 || aiIndex >= perks.Length
		Debug.Trace("[AoT] Card: buy refused, bad node " + aiIndex + " in " + skill)
		Return
	EndIf
	Perk target = NextToBuy(perks[aiIndex])
	Int before = PerkPoints()
	Bool bought = False
	If target != None
		bought = Lodestone.TryBuyPerk(target)
	EndIf
	Int after = PerkPoints()
	Bool owned = False
	If target != None
		owned = Lodestone.HasPerk(target)
	EndIf
	AoT_Core.Log("[AoT] Card: buy skill=" + skill + " node=" + aiIndex + " perk=" + target + " bought=" + bought + " points " + before + " -> " + after + " owned=" + owned)
	If _visible
		Lodestone.WebUICall(ViewId, FnCard, BuildTree(aiSlot))
	EndIf
EndFunction

Function ShowPlain()
	{Where the panel is not possible (no backend, old DLL, focus refused, page
	dead): the same facts as a message box, so the key never ends in nothing.}
	; D154: a card already in the hand goes away first (focus refused, page silent)
	AnimClose("plain")
	String rankLetter = RankLetter(AoT_Core.GetRank())
	String text = "Adventurer card - rank " + rankLetter + ", level " + Game.GetPlayer().GetLevel() + ". Points " + AoT_Core.GetPoints()
	Int step = AoT_Core.LadderStep(AoT_Core.GetRank())
	If step >= 0
		text += " / " + step
	EndIf
	If AoT_Core.IsPromotionEligible()
		text += ". Ready for the promotion exam."
	EndIf
	Debug.MessageBox(text)
EndFunction

String Function RankLetter(Int aiRank)
	String letters = "FEDCBAS"
	If aiRank < 0 || aiRank > 6
		Return "?"
	EndIf
	Return StringUtil.GetNthChar(letters, aiRank)
EndFunction
